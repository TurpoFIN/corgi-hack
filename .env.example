AGENT37_API_KEY=your_agent37_key
# ID of your Agent37 instance running the desktop image in infra/agent37-desktop
AGENT37_INSTANCE_ID=your_desktop_instance_id
PORT=5173
# Optional: otherwise read MONID_API_KEY directly from hsec before each mission.
# MONID_API_KEY=
# MONID_HSEC_NAME=MONID_API_KEY

# Optional shared source catalog. Secrets can stay in hsec.
# hsec entries: monid, supabase-corgi-hack
SUPABASE_PROJECT_REF=
SUPABASE_HSEC_NAME=supabase-corgi-hack
MONID_HSEC_NAME=monid
